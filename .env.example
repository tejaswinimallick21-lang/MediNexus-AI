# MediNexus AI — Environment Configuration
# Multi-LLM Provider Support:
# 1. xAI Grok API (Optional): Set GROK_API_KEY to enable Grok reasoning.
GROK_API_KEY=
GROK_MODEL=grok-beta

# 2. Google Gemini API (Optional): Set GEMINI_API_KEY to enable Gemini 1.5 Flash.
GEMINI_API_KEY=

# Note: If no API keys are provided, MediNexus AI runs 100% offline using its
# built-in deterministic local grounded retriever over DuckDB Lakehouse and guidelines.
