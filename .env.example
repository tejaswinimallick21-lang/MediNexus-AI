# MediNexus AI — environment configuration
# Copy this file to `.env` (same folder) and fill in values. `.env` is gitignored: never commit real keys.

# --- AI assistants (Nexa agents) -------------------------------------------------------------
# Set ONE of these. With neither, the assistants run a free rules engine that answers only from data.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
# NEXA_LLM_PROVIDER=openai          # openai | claude | rules
# NEXA_OPENAI_MODEL=gpt-4o-mini
# NEXA_CLAUDE_MODEL=claude-opus-5-5
# NEXA_MAX_STEPS=5                  # tool rounds per question (cost cap)
# NEXA_OPENAI_MAX_TOKENS=700        # reply length cap (cost cap)
# NEXA_EMBEDDINGS=                  # "local" forces the free offline embeddings for policy search

# --- Morning sweep (scheduled agent) ---------------------------------------------------------
# NEXA_SWEEP_ENABLED=1
# NEXA_SWEEP_TIME=07:00
# NEXA_SWEEP_MAX=20

# --- Security --------------------------------------------------------------------------------
# A long random value keeps people signed in across API restarts, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDINEXUS_JWT_SECRET=
# Password used by `npm run seed` for the three accounts (defaults to the documented demo password)
MEDINEXUS_SEED_PASSWORD=
# MEDINEXUS_ENV=development         # production enables stricter posture checks
# MEDINEXUS_COOKIE_SECURE=false     # set true when served over HTTPS

# --- Legacy RAG answer generator (optional; only src/rag/knowledge_base.py uses these) ---------
GROK_API_KEY=
GROK_MODEL=grok-beta
GEMINI_API_KEY=
