# systemd unit for the MediNexus API. setup_server.sh fills in __APP_DIR__ and __USER__.
# One process only: DuckDB allows a single writer, and the morning sweep (and the optional data feed)
# run inside this process. Never add --workers.
[Unit]
Description=MediNexus AI API (FastAPI)
After=network.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=LOKY_MAX_CPU_COUNT=2

[Install]
WantedBy=multi-user.target
